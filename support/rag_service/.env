# SSO配置
SSO_ENABLED=false
SSO_PLATFORM_URL="http://192.168.31.233:8081"
SSO_LOGIN_PATH="/casic-pro/login?back="
SSO_USERINFO_API="/admin-api/system/oauth2/userinfo?access_token="
SSO_REQUEST_TIMEOUT=10
SSO_USERNAME_FIELD="preferred_username"
SSO_ENABLE_MAP_TO_USER=true
SSO_DEFAULT_MAPPED_USER="admin"

# 调试配置
SWAGGER_ENABLED=true
PROFILE_ENABLED=false