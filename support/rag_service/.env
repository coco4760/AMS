# 多线程配置
MAX_GUNICORN_WORKERS=32

# 数据库配置
POSTGRES_SERVER=rag_service_postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rag_service

# Redis配置
REDIS_SERVER=rag_service_redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CELERY_DB=1

# 认证配置
SECRET_KEY="H826cHl3Mn5SeBUfXlq4wH6JqIkWoMTq"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS配置
BACKEND_CORS_ORIGINS=["http://localhost:8081"]

# 文件存储配置
UPLOAD_DIR=/app/data/uploads
BACKUP_DIR=/app/data/backups

# 向量数据库配置 (多选)
# vectorchord
VECTORCHORD_ENABLED=true
# qdrant
QDRANT_ENABLED=true
QDRANT_URL="http://rag_service_qdrant:6333"
QDRANT__SERVICE__API_KEY="clouditera"
# milvus
MILVUS_ENABLED=false
MILVUS_URL="http://rag_service_milvus:19530"
MILVUS_API_KEY="root:Milvus"
# chroma
CHROMA_ENABLED=false
CHROMA_HOST="rag_service_chroma"
CHROMA_PORT=8000

# MinerU
# MINERU_API_KEY="b61a3d38-87ae-459e-b728-03c8de24d526"
